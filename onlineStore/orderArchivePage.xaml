<Page x:Class="onlineStore.orderArchivePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:onlineStore"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="orderArchivePage">

    <Grid>
        <DataGrid Name="orderArchiveDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding date}" Header="Дата заказа" Width="100"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding statuses.name}" Header="Статус" Width="100"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding users.name}" Header="Пользователь" Width="*"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
