<Window x:Class="onlineStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:onlineStore"
        mc:Ignorable="d"
        Title="Магазин цветов" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Frame Grid.Row="1" Name="myFrame" ></Frame>
        <Grid Background="AliceBlue"></Grid>
        <Grid Grid.Row="2" Background="AliceBlue" ></Grid>
        <Button Margin="10" Content="На страницу входа" HorizontalAlignment="Right"  VerticalAlignment="Center" Width="130" Height="30"  Click="Button_back" />
    </Grid>
</Window>
