<Page x:Class="onlineStore.adminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:onlineStore"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="adminPage">

    <Grid>
        <DataGrid Name="adminDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding name}" Header="Название" Width="300"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding price}" Header="Цена"  Width="100"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding category}" Header="Категория" Width="200"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding quantity}" Header="Остаток" Width="*"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
