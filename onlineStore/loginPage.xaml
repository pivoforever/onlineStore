<Page x:Class="onlineStore.loginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:onlineStore"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="800"
      Title="loginPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Content="Логин" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center" Height="50" Width="108"/>
        <Label Content="Пароль" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="2" Height="50" Width="130"/>
        <TextBox Name="loginTextBox" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Grid.Row="1" Height="28"/>
        <PasswordBox Name="passwordBox" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Grid.Row="3" Height="28"/>
        <Button Content="Вход" HorizontalAlignment="Center"  VerticalAlignment="Center" Width="130" Height="30" Grid.Row="4" Click="Button_Click"/>

    </Grid>
</Page>
